{
  "name": "serie-attractor-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bake": "UV_CACHE_DIR=/tmp/uv-cache uv run --no-project --with-editable .. python bake_demo_data.py",
    "bake:rs": "cargo run -q --manifest-path ../../serie-rs/Cargo.toml -- demo shapes --n-points 2000 --n-draws 12 --out public/attractor_data.json",
    "typecheck": "tsc -b",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "postprocessing": "^6.37.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
