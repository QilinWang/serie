# Python caches/build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Local environments and secrets
.venv/
.env
.env.*
secrets.*
.claude/

# Large/local data and generated outputs
/assets/**
# A directory rule stops git descending, and a negation it never reaches does
# nothing; `/assets/**` with the directories re-included is what makes the two
# rules below actually fire. The tree is 21 files, so the walk costs nothing.
!/assets/**/
# ...but not the code that BUILDS a prepared asset, nor the manifest that
# records what it built. The tensors are regenerable and huge; the builder and
# its manifest are the provenance of a benchmark world (which recording, which
# rows, which columns, which sha256), so a paper world stays reproducible only
# if they are tracked.
!/assets/**/build_*.py
!/assets/**/*_manifest.json
tmp/
release_artifacts/

# SERIE demo development artifacts
demo/node_modules/
demo/dist/
demo/.vite/
demo/*.tsbuildinfo
demo/vite.config.js
demo/vite.config.d.ts
demo/public/attractor_data.json

# Packaged viewer template must not contain baked data.
demo_dist/attractor_data.json

# OS/editor noise
.DS_Store
Thumbs.db
